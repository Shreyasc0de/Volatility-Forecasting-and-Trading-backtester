# Backend Environment Variables
# Copy to .env and fill in values

# Data Configuration
DATA_REFRESH_INTERVAL=86400  # Seconds (24 hours)
DEFAULT_SYMBOLS=SPY,AAPL,BTC-USD
DATA_PERIOD=5y

# Model Parameters
GARCH_ORDER_P=1
GARCH_ORDER_Q=1
N_REGIMES=2
REGIME_AR_LAGS=0

# Backtest Parameters
BACKTEST_WINDOW_SIZE=252  # Trading days
BACKTEST_STEP_SIZE=63     # Quarterly rebalance
VOL_TARGET=0.15

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
